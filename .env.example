# =============================================================================
# Production environment for docker-compose.master.yaml
# Copy to .env on the server and fill real values:
#   cp .env.example .env
# Start:
#   docker compose -f docker-compose.master.yaml --env-file .env up -d --build
# =============================================================================

# --- Paths to sibling projects (absolute paths on the deploy host) ---
ADMIN_APP_PATH=/home/common_user/egor_bot/bot_admin
FRONTEND_APP_PATH=/home/common_user/egor_bot/Egor_frontend/foodmap_front
MEDIA_HOST_PATH=/home/common_user/egor_bot/media

# Compatibility alias used by older compose files
ADMIN_APP_PASS=${ADMIN_APP_PATH}
FODMAP_APP_PATH=${FRONTEND_APP_PATH}

# --- Global / debug (MUST stay False in production) ---
DEBUG=False
DEVELOP=False
DJANGO_DEBUG=False
LOG_LEVEL=INFO
DJANGO_SETTINGS_MODULE=bot_admin.develop_settings

# --- Secrets ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
SECRET_KEY=change-me-to-a-long-random-string

# --- MySQL ---
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_USER=egor_user
MYSQL_PASSWORD=change-me-db-password
MYSQL_DATABASE=egor_db
MYSQL_DATABASE_DJANGO=django_db
# Legacy aliases used by the Telegram bot code (if started later)
DB_USER=${MYSQL_USER}
DB_PASS=${MYSQL_PASSWORD}

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# --- Django / DRF hosts & CORS ---
ALLOWED_HOSTS=fodmap.moscow,www.fodmap.moscow,dev.fodmap.moscow,www.dev.fodmap.moscow,localhost,127.0.0.1,nginx,admin_bot
CSRF_TRUSTED_ORIGINS=https://fodmap.moscow,https://www.fodmap.moscow,https://dev.fodmap.moscow,https://www.dev.fodmap.moscow
CORS_ALLOWED_ORIGINS=https://fodmap.moscow,https://www.fodmap.moscow,https://dev.fodmap.moscow,https://www.dev.fodmap.moscow

# --- Frontend build args (same origin via nginx → leave VITE_API_URL empty) ---
VITE_API_URL=
VITE_BACKEND_MEDIA=/media/
VITE_ADMIN_URL=/admin/

# --- Mail / SMTP (registration passwords via Celery) ---
MAIL_LOGIN=
MAIL_PASS=
MAIL_SERVER=smtp.timeweb.ru
MAIL_MAIN_SERVER=mail.timeweb.com
MAIL_POP3_SERVER=pop3.timeweb.ru
MAIL_IMAP_SERVER=imap.timeweb.ru
MAIL_SMTP_PORT=465
MAIL_USE_SSL=True
MAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- Telegram (optional; bot container is NOT started by master compose) ---
TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://dev.fodmap.moscow/webhook
TELEGRAM_WEBAPP_URL=https://dev.fodmap.moscow
WEBAPP_URL=https://dev.fodmap.moscow
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me-webhook-secret
WEBHOOK_URL=https://dev.fodmap.moscow
WEBHOOK_PORT=8443
WEBHOOK_SSL_CERT=/etc/letsencrypt/live/fodmap.moscow/fullchain.pem
WEBHOOK_SSL_PRIV=/etc/letsencrypt/live/fodmap.moscow/privkey.pem
WEB_SERVER_HOST=bot
WEB_SERVER_PORT=5000
AUTHOR_PASS=

# --- Public media URLs ---
IMG_LINK_FULL=https://dev.fodmap.moscow/media/full_size
IMG_LINK_THUMBNAILS=https://dev.fodmap.moscow/media/thumbnails

# --- Payments (optional) ---
PAY_LINK_100=
PAY_LINK_200=
PAY_LINK_300=
PAY_LINK_400=
PAY_LINK_500=
PAY_LINK_1000=
PAY_LINK_5000=

# --- Timezone ---
TZ=Europe/Moscow
